# Copy to .env.production for production deployment (git-ignored).
APP_ENV=production
DEBUG=false
LOG_LEVEL=info

# Qdrant Cloud (managed — no local Qdrant container needed)
QDRANT_URL=https://773125ea-efc2-4c2c-81dd-9b4be54c5a66.europe-west6-0.gcp.cloud.qdrant.io
QDRANT_COLLECTION=enterprise_documents
QDRANT_API_KEY=

# Embedding / reranker models (cached on first run via HF_HOME)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_BATCH_SIZE=32

DENSE_TOP_K=30
SPARSE_TOP_K=30
RERANK_TOP_K=8

HYBRID_METHOD=rrf
HYBRID_ALPHA=0.65
RRF_K=60

QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_COUNT=3
QUERY_EXPANSION_MODEL=gpt-4o-mini

CHUNK_SIZE=800
CHUNK_OVERLAP=120
CHUNKING_STRATEGY=recursive

CONTEXT_MAX_CHUNKS=8
CONTEXT_MAX_CHARACTERS=30000

# Use a real provider in production; set to "mock" for keyless demo mode.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
MAX_UPLOAD_SIZE_MB=50

# CORS — allow the GitHub Pages frontend origin
CORS_ORIGINS=https://vizdumb2005.github.io

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERY_PER_MIN=60
RATE_LIMIT_EVAL_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=30
