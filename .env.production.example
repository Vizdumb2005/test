# Production — strict errors, restricted CORS, persistent storage
APP_ENV=production
DEBUG=false
LOG_LEVEL=info

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enterprise_documents

# Use a real provider in production; NEVER commit the key.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# Or keyless demo mode:
LLM_PROVIDER=mock

# Comma-separated allowed origins (no wildcards here)
CORS_ORIGINS=https://your-frontend.example.com

RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERY_PER_MIN=60
RATE_LIMIT_EVAL_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=30

MAX_UPLOAD_SIZE_MB=50
