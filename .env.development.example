# Development — local iteration, verbose errors, permissive CORS
APP_ENV=development
DEBUG=true
LOG_LEVEL=info

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_documents

# Keyless demo answers (real retrieval, deterministic mock generation)
LLM_PROVIDER=mock
LLM_MODEL=demo

RATE_LIMIT_ENABLED=true
